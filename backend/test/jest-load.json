{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "globalSetup": "<rootDir>/e2e/global-setup.ts",
  "globalTeardown": "<rootDir>/e2e/global-teardown.ts",
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/e2e/after-env.ts"],
  "testEnvironment": "node",
  "testRegex": ".perf-spec.ts$",
  "testTimeout": 900000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
