# Copy to backend/.env and fill in. Never commit backend/.env.
# The app checks these at startup and stops with a clear message if one is wrong.

NODE_ENV=development
PORT=3000

# Required
MONGODB_URI=
# At least 32 characters
JWT_SECRET=
FRONTEND_URL=http://localhost:3001

# Access-token lifetime (the 30-minute idle rule is separate)
JWT_EXPIRES_IN=15m
# Keep true. Set false only if your browser drops cookies on http://localhost (e.g. Safari);
# refused when NODE_ENV=production.
COOKIE_SECURE=true

# Admin seed (npm run seed:admin); the password must follow the account password rule
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments and exchange rates (backend only, never sent to the frontend)
# PAY-04: the single platform currency (default USD). Keep USD; never change it
# once the database holds prices.
PLATFORM_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FXRATES_API_KEY=

# GEN-01-B: emails through SMTP, a test inbox in development (Mailtrap or
# Ethereal). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Travel Platform <no-reply@example.test>

# Optional: a throwaway database for npm run test:e2e (never the shared one)
E2E_MONGODB_URI=
